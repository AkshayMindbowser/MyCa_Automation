{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create Jira Issue",
      "type": "shell",
      "command": "npm run create-jira-issue -- --type \"${input:type}\" --summary \"${input:summary}\" --description \"${input:description}\"",
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "type",
      "type": "promptString",
      "description": "Issue type (Bug/Story/Task)",
      "default": "Bug"
    },
    {
      "id": "summary",
      "type": "promptString",
      "description": "Issue summary"
    },
    {
      "id": "description",
      "type": "promptString",
      "description": "Issue description",
      "default": ""
    }
  ]
}
